# Variables d'environnement du projet Summer Club.

# Base de données PostgreSQL (Prisma). Valeur d'exemple, à adapter localement.
DATABASE_URL="postgresql://summerclub:dev@localhost:5433/summerclub"

# Better Auth. Secret utilisé pour signer les sessions : obligatoire, au moins 32
# caractères (src/server/auth.ts refuse de démarrer sinon). Laissé vide à dessein — une
# valeur d'exemple ici finirait un jour en production, publiée dans ce dépôt. Générez une
# vraie valeur aléatoire avec :
#   openssl rand -base64 32
# ou, sans openssl :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Compte administrateur créé par `prisma/seed.ts` au premier lancement (mot de passe haché
# par Better Auth, jamais stocké en clair). Sans ces deux variables, aucun compte n'est créé.
# Mot de passe : 12 caractères minimum.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="changez-moi-12-caracteres-minimum"

# Ce fichier sera complété au fil des tâches suivantes (paiement, etc.).
