# Variables d'environnement du projet Summer Club.

# Base de données PostgreSQL (Prisma). Valeur d'exemple, à adapter localement.
DATABASE_URL="postgresql://summerclub:dev@localhost:5433/summerclub"

# Better Auth. Secret utilisé pour signer les sessions : obligatoire, au moins 32
# caractères (src/server/auth.ts refuse de démarrer sinon). Laissé vide à dessein — une
# valeur d'exemple ici finirait un jour en production, publiée dans ce dépôt. Générez une
# vraie valeur aléatoire avec :
#   openssl rand -base64 32
# ou, sans openssl :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Compte administrateur créé par `prisma/seed.ts` au premier lancement (mot de passe haché
# par Better Auth, jamais stocké en clair). Sans ces deux variables, aucun compte n'est créé.
# Mot de passe : 12 caractères minimum.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="changez-moi-12-caracteres-minimum"

# Numéro WhatsApp Business de la boutique, au format international : des CHIFFRES
# uniquement, sans « + », sans espace et sans indicatif local (261XXXXXXXXX pour
# Madagascar). C'est la forme que wa.me attend dans son chemin.
#
# Laissé vide à dessein : le numéro réel est une dépendance externe (spec § 12), il ne
# s'invente pas — un numéro approximatif ouvrirait une conversation avec une inconnue, qui
# recevrait les demandes des clientes. Tant que cette variable est vide ou mal formée,
# aucun lien WhatsApp n'est rendu en page d'accueil (src/components/home/call-to-action.tsx) :
# un lien mort est un défaut, pas une promesse.
#
# La tâche 18 (tunnel de commande, canal WhatsApp) lira le même numéro pour composer le
# message pré-rempli, et normalisera les formes locales (« 032 46 182 90 ») vers celle-ci.
WHATSAPP_NUMBER=""

# Ce fichier sera complété au fil des tâches suivantes (paiement, etc.).
