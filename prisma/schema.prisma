generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  member
}

// Modèle aligné sur le schéma attendu par Better Auth (cf. node_modules/@better-auth/core
// db/schema/user.ts et le plugin admin) : la colonne s'appelle désormais `name`, comme la
// bibliothèque l'attend, donc la configuration `user.fields` de src/server/auth.ts n'a plus
// de mapping à faire. `role` reste l'énumération Prisma existante ; le plugin admin est
// configuré avec `adminRoles: ['admin']` et `defaultRole: 'member'` pour rester compatible
// avec ses deux seules valeurs. `banned`/`banReason`/`banExpires` sont exigés par le plugin
// admin (fonctionnalités de bannissement non utilisées ici mais nécessaires pour que
// l'adaptateur Prisma puisse lire/écrire le modèle sans erreur).
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified Boolean   @default(false)
  name          String
  image         String?
  phone         String?
  role          Role      @default(member)
  banned        Boolean   @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
}

model Session {
  id             String   @id @default(cuid())
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Category {
  id           String    @id @default(cuid())
  slug         String    @unique
  name         String
  description  String?
  image        String?
  displayOrder Int       @default(0)
  products     Product[]
}

model Product {
  id              String    @id @default(cuid())
  slug            String    @unique
  name            String
  description     String
  categoryId      String
  category        Category  @relation(fields: [categoryId], references: [id])
  basePrice       Int
  costPrice       Int       @default(0)
  active          Boolean   @default(true)
  displayOrder    Int       @default(0)
  metaTitle       String?
  metaDescription String?
  variants        Variant[]
  media           Media[]
  reviews         Review[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([active, displayOrder])
  @@index([categoryId])
}

model Variant {
  id                String      @id @default(cuid())
  productId         String
  product           Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  label             String
  sku               String      @unique
  priceDelta        Int         @default(0)
  stock             Int         @default(0)
  lowStockThreshold Int         @default(2)
  orderItems        OrderItem[]

  @@unique([productId, label])
  @@index([productId])
}

model Media {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  path      String
  alt       String
  position  Int     @default(0)
  isPrimary Boolean @default(false)

  @@index([productId, position])
}

enum Channel {
  orange_money
  whatsapp
  cash_on_delivery
}

enum OrderStatus {
  pending_confirmation
  pending_payment
  confirmed
  preparing
  shipped
  ready_for_pickup
  delivered
  cancelled
  payment_failed
}

model Order {
  id            String        @id @default(cuid())
  reference     String        @unique
  trackingToken String        @unique
  channel       Channel
  status        OrderStatus   @default(pending_confirmation)
  customerName  String
  phone         String
  email         String?
  zoneId        String?
  zone          DeliveryZone? @relation(fields: [zoneId], references: [id])
  address       String?
  subtotal      Int
  shippingFee   Int
  discount      Int           @default(0)
  total         Int
  items         OrderItem[]
  payments      Payment[]
  reviews       Review[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, createdAt])
}

model OrderItem {
  id                String  @id @default(cuid())
  orderId           String
  order             Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId         String
  variant           Variant @relation(fields: [variantId], references: [id])
  nameSnapshot      String
  unitPriceSnapshot Int
  quantity          Int

  @@index([orderId])
}

model Payment {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id])
  provider       String
  amount         Int
  status         String
  externalRef    String?
  rawPayload     Json?
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  @@index([orderId])
}

enum PromotionScope {
  product
  category
  all
}

enum PromotionType {
  percent
  fixed
}

model Promotion {
  id          String         @id @default(cuid())
  name        String
  type        PromotionType
  value       Int
  scope       PromotionScope
  targetId    String?
  startsAt    DateTime?
  endsAt      DateTime?
  weekdays    Int            @default(127)
  startHour   Int?
  endHour     Int?
  membersOnly Boolean        @default(false)
  priority    Int            @default(0)
  active      Boolean        @default(true)
}

enum ReviewSource {
  verified
  imported
}

enum ReviewStatus {
  pending
  published
  rejected
}

model Review {
  id        String       @id @default(cuid())
  productId String?
  product   Product?     @relation(fields: [productId], references: [id])
  orderId   String?
  order     Order?       @relation(fields: [orderId], references: [id])
  rating    Int
  body      String
  author    String
  source    ReviewSource
  status    ReviewStatus @default(pending)
  pinned    Boolean      @default(false)
  position  Int          @default(0)
  createdAt DateTime     @default(now())

  @@index([productId])
  @@index([status, pinned])
}

model DeliveryZone {
  id           String  @id @default(cuid())
  name         String
  fee          Int
  leadTime     String
  active       Boolean @default(true)
  displayOrder Int     @default(0)
  orders       Order[]
}

model Setting {
  key   String @id
  value Json
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([entity, createdAt])
}
